<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="container mt-5">
      <h1 class="text-center">Welcome, <%= user.username %></h1>
      <h2 class="text-center mb-4">Your Dashboard</h2>

      <div class="card mb-4">
        <div class="card-header">
          <h3>Add a New Blog</h3>
        </div>
        <div class="card-body">
          <form action="/addblog" method="POST">
            <div class="mb-3">
              <label for="title" class="form-label">Blog Title:</label>
              <input type="text" name="title" class="form-control" required />
            </div>

            <div class="mb-3">
              <label for="content" class="form-label">Blog Content:</label>
              <textarea
                name="content"
                class="form-control"
                rows="5"
                required
              ></textarea>
            </div>

            <input type="hidden" name="username" value="<%= user.username %>" />

            <button type="submit" class="btn btn-primary">Add Blog</button>
          </form>
        </div>
      </div>

      <h3>Your Blogs</h3>
      <% if (userBlogs.length > 0) { %>
      <div class="list-group mb-4">
        <% userBlogs.forEach(blog => { %>
        <div class="list-group-item">
          <h5><%= blog.username %></h5>
          <h5><%= blog.title %></h5>
          <p><%= blog.content.substring(0, 100) %>...</p>
          <a href="/editblog/<%= blog._id %>" class="btn btn-warning btn-sm"
            >Edit</a
          >
          <a
            href="/deleteblog/<%= blog._id %>"
            class="btn btn-danger btn-sm ms-2"
            >Delete</a
          >
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <p class="text-muted">You have not created any blogs yet.</p>
      <% } %>

      <div class="mt-4 mb-4">
        <a href="/profile" class="btn btn-secondary">Go to Profile</a>
        <a href="/logout" class="btn btn-danger ms-2">Logout</a>
      </div>

      <h3>Other Blogs</h3>
      <% if (otherBlogs.length > 0) { %>
      <div class="list-group">
        <% otherBlogs.forEach(blog => { %>
        <div class="list-group-item">
          <h5><%= blog.username %></h5>
          <h5><%= blog.title %></h5>
          <p><%= blog.content.substring(0, 100) %>...</p>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <p class="text-muted">No blogs available.</p>
      <% } %>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
